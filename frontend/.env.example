# Base URL of the backend API (no trailing slash), e.g.
# https://aiip-backend.onrender.com in production.
#
# IMPORTANT: Vite environment variables are baked into the static
# bundle at BUILD TIME, not read at runtime. On Render, set
# VITE_API_BASE_URL in the Static Site's environment variables before
# building — changing it later requires a rebuild/redeploy.
#
# Defaults to http://localhost:8000 if unset (local development only).
VITE_API_BASE_URL=http://localhost:8000
