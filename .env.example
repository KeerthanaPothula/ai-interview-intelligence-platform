# =============================================================
# AI Interview Intelligence Platform — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================


# -------------------------------------------------------------
# Application
# -------------------------------------------------------------

# Runtime environment. Controls behaviour that should differ
# between local dev and production (e.g. error detail in HTTP
# responses, auto-reload). Values: development | production
ENVIRONMENT=development

# When true, FastAPI returns full exception tracebacks in error
# responses and enables the interactive /docs and /redoc UIs.
# Must be set to false in production.
DEBUG=true


# -------------------------------------------------------------
# PostgreSQL
# These must match what Docker Compose passes to the postgres
# container. The backend uses DATABASE_URL to connect.
# -------------------------------------------------------------

# Name of the PostgreSQL database
POSTGRES_DB=aiip_db

# PostgreSQL login username
POSTGRES_USER=aiip_user

# PostgreSQL login password — use a strong value in production
POSTGRES_PASSWORD=change_me_before_use

# Full SQLAlchemy connection string.
# Host must be "postgres" (the Docker Compose service name),
# not "localhost", when running inside Docker.
DATABASE_URL=postgresql+psycopg2://aiip_user:change_me_before_use@postgres:5432/aiip_db


# -------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------

# Secret key used to sign and verify JWT tokens.
# Generate a strong value with:  openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_char_hex_secret_generated_via_openssl_rand_hex_32

# Signing algorithm. HS256 is standard for symmetric JWTs.
JWT_ALGORITHM=HS256

# How long an access token stays valid (in minutes).
# 1440 = 24 hours. Reduce to 15–60 for stricter security.
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# -------------------------------------------------------------
# Gemini API  (used from Week 2 onward)
# -------------------------------------------------------------

# Your Google AI Studio API key.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum number of questions Gemini will be asked to generate
# per session. Sent directly as the count in the prompt.
# Range: 3–20. Default: 10.
MAX_QUESTIONS_PER_SESSION=10

# Maximum seconds to wait for Gemini to return a response
# (connect + read). Must be > 0. Default: 30.
GEMINI_TIMEOUT_SECONDS=30


# -------------------------------------------------------------
# Whisper  (used from Week 2 onward)
# -------------------------------------------------------------

# Whisper model size to load for transcription.
# Options (smallest → largest / fastest → most accurate):
#   tiny | base | small | medium | large-v2 | large-v3
# Use "base" locally. Switch to "large-v3" on a GPU server.
WHISPER_MODEL=base


# -------------------------------------------------------------
# Processing Pipeline  (used from Week 3 onward)
# -------------------------------------------------------------

# Master switch for the audio processing pipeline (Whisper
# transcription + Gemini evaluation). When false, POST
# /responses/{id}/process returns 503 and uploads skip background
# processing. Set to true in production. Default: true.
ENABLE_AUDIO_PROCESSING=true

# Maximum characters of transcript text sent to Gemini for
# evaluation; longer transcripts are truncated before the API call.
# Must be > 0. Default: 20000.
MAX_TRANSCRIPT_CHARS=20000

# Maximum seconds a Whisper transcription job may run before being
# marked failed with a "timed out" error. Must be > 0. Default: 300.
WHISPER_TIMEOUT_SECONDS=300


# -------------------------------------------------------------
# File Uploads  (used from Week 2 onward)
# -------------------------------------------------------------

# Directory where audio response files are stored, relative to
# the backend working directory. Created automatically on first
# upload if it does not exist. Use an absolute path in production
# (e.g. /data/uploads) when mounting an external volume.
UPLOAD_DIR=uploads

# Maximum accepted audio file size in megabytes. Requests larger
# than this are rejected with HTTP 413. The upload_service
# converts this to bytes internally (MB × 1024 × 1024).
# 50 MB fits a 5-minute audio clip at 128 kbps MP3.
MAX_UPLOAD_SIZE_MB=50


# -------------------------------------------------------------
# CORS
# -------------------------------------------------------------

# Comma-separated list of exact frontend origins allowed to make
# cross-origin requests to this API. Whitespace around each origin
# is trimmed and empty entries are ignored.
#
# A wildcard ("*") is intentionally NOT supported: allow_origins=["*"]
# combined with allow_credentials=True (required for the Authorization
# header used by JWT auth) is rejected by browsers — the CORS spec
# forbids pairing a wildcard origin with credentialed requests. List
# the exact origin(s) instead.
#
# Local development (Create React App + Vite dev servers):
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
#
# Production (replace with your deployed frontend domain):
# CORS_ORIGINS=https://your-frontend-domain.com
#
# Leave empty (default) to disable cross-origin requests entirely.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# -------------------------------------------------------------
# Observability (Phase 4)
# -------------------------------------------------------------

# Root logger level. One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# "json" emits structured one-line-per-record logs suitable for log
# aggregation in production. "text" is more readable for local terminals.
LOG_FORMAT=json

# Header used to read/echo a request correlation ID.
REQUEST_ID_HEADER=X-Request-ID

# Requests slower than this many milliseconds are logged at WARNING.
SLOW_REQUEST_THRESHOLD_MS=1000

# Master switch for Prometheus instrumentation and the /metrics endpoint.
ENABLE_METRICS=true

# Master switch for OpenTelemetry tracing. Disabled by default — pulls in
# the OpenTelemetry SDK and exports spans only when explicitly enabled.
ENABLE_TRACING=false

# Logical service name attached to every span.
OTEL_SERVICE_NAME=ai-interview-intelligence-platform

# OTLP/HTTP collector endpoint, e.g. http://localhost:4318/v1/traces.
# Leave unset to export spans to the console instead (local debugging).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fraction of traces to sample: 0.0 (none) to 1.0 (all).
OTEL_TRACES_SAMPLE_RATE=1.0

# Maximum seconds the /ready endpoint waits for its database check.
READINESS_DB_TIMEOUT_SECONDS=2.0
