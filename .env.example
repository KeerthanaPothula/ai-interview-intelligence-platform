# =============================================================
# AI Interview Intelligence Platform — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================


# -------------------------------------------------------------
# Application
# -------------------------------------------------------------

# Runtime environment. Controls behaviour that should differ
# between local dev and production (e.g. error detail in HTTP
# responses, auto-reload). Values: development | production
ENVIRONMENT=development

# When true, FastAPI returns full exception tracebacks in error
# responses and enables the interactive /docs and /redoc UIs.
# Must be set to false in production.
DEBUG=true


# -------------------------------------------------------------
# PostgreSQL
# These must match what Docker Compose passes to the postgres
# container. The backend uses DATABASE_URL to connect.
# -------------------------------------------------------------

# Name of the PostgreSQL database
POSTGRES_DB=aiip_db

# PostgreSQL login username
POSTGRES_USER=aiip_user

# PostgreSQL login password — use a strong value in production
POSTGRES_PASSWORD=change_me_before_use

# Full SQLAlchemy connection string.
# Host must be "postgres" (the Docker Compose service name),
# not "localhost", when running inside Docker.
DATABASE_URL=postgresql+psycopg2://aiip_user:change_me_before_use@postgres:5432/aiip_db


# -------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------

# Secret key used to sign and verify JWT tokens.
# Generate a strong value with:  openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_char_hex_secret_generated_via_openssl_rand_hex_32

# Signing algorithm. HS256 is standard for symmetric JWTs.
JWT_ALGORITHM=HS256

# How long an access token stays valid (in minutes).
# 1440 = 24 hours. Reduce to 15–60 for stricter security.
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# -------------------------------------------------------------
# Gemini API  (used from Week 2 onward)
# -------------------------------------------------------------

# Your Google AI Studio API key.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum number of questions Gemini will be asked to generate
# per session. Sent directly as the count in the prompt.
# Range: 3–20. Default: 10.
MAX_QUESTIONS_PER_SESSION=10


# -------------------------------------------------------------
# Whisper  (used from Week 2 onward)
# -------------------------------------------------------------

# Whisper model size to load for transcription.
# Options (smallest → largest / fastest → most accurate):
#   tiny | base | small | medium | large-v2 | large-v3
# Use "base" locally. Switch to "large-v3" on a GPU server.
WHISPER_MODEL=base


# -------------------------------------------------------------
# File Uploads  (used from Week 2 onward)
# -------------------------------------------------------------

# Directory where audio response files are stored, relative to
# the backend working directory. Created automatically on first
# upload if it does not exist. Use an absolute path in production
# (e.g. /data/uploads) when mounting an external volume.
UPLOAD_DIR=uploads

# Maximum accepted audio file size in megabytes. Requests larger
# than this are rejected with HTTP 413. The upload_service
# converts this to bytes internally (MB × 1024 × 1024).
# 50 MB fits a 5-minute audio clip at 128 kbps MP3.
MAX_UPLOAD_SIZE_MB=50
